rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. 온통대전 주유소 현장 검증 및 위치 검증 통계 컬렉션
    match /daejeon_gas_verifications/{stationId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly([
        'oper', 'inoper', 'lastTime', 'updatedAt',
        'locOk', 'locWrong', 'lastLocTime'
      ]);
    }

    // 2. 시민 위치 오류 수정 제보 내역 컬렉션
    match /daejeon_gas_location_reports/{reportId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['stationId', 'stationName', 'note', 'createdAt'])
                   && request.resource.data.note is string
                   && request.resource.data.note.size() > 0
                   && request.resource.data.note.size() <= 1000;
      allow update, delete: if false;
    }

    // 3. 🔍 신규 발견 주유소 시민 등록 & 확인 투표 자동 승격 컬렉션
    match /daejeon_gas_candidates/{candidateId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'addr', 'brand', 'type', 'lat', 'lng', 'phone', 'reason',
        'votesYes', 'votesNo', 'status', 'createdAt', 'updatedAt'
      ]) && request.resource.data.name is string && request.resource.data.name.size() > 0
         && request.resource.data.addr is string && request.resource.data.addr.size() > 0
         && request.resource.data.lat is number && request.resource.data.lng is number;
      allow update: if request.resource.data.keys().hasOnly([
        'name', 'addr', 'brand', 'type', 'lat', 'lng', 'phone', 'reason',
        'votesYes', 'votesNo', 'status', 'createdAt', 'updatedAt'
      ]);
      allow delete: if false;
    }
  }
}
