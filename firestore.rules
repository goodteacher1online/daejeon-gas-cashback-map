rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. 온통대전 주유소 현장 검증 및 위치 검증 통계 컬렉션
    match /daejeon_gas_verifications/{stationId} {
      // 모든 사용자가 실시간 검증 현황 조회 가능
      allow read: if true;
      
      // 지정된 필수/허용 필드만 기록 가능 (악의적 임의 필드 주입 차단)
      allow create, update: if request.resource.data.keys().hasOnly([
        'oper', 'inoper', 'lastTime', 'updatedAt',
        'locOk', 'locWrong', 'lastLocTime'
      ]);
      
      // 주유소 통계 데이터 삭제 절대 금지
      allow delete: if false;
    }

    // 2. 시민 위치 오류 수정 제보 내역 컬렉션
    match /daejeon_gas_location_reports/{reportId} {
      // 제보 내역 조회 허용
      allow read: if true;
      
      // 제보 작성 시 규격 검증 (지정 필드 및 글자수 1000자 제한)
      allow create: if request.resource.data.keys().hasOnly(['stationId', 'stationName', 'note', 'createdAt'])
                   && request.resource.data.note is string
                   && request.resource.data.note.size() > 0
                   && request.resource.data.note.size() <= 1000;
      
      // 이미 등록된 제보의 임의 변조 및 삭제 차단
      allow update, delete: if false;
    }

    // 3. 🔍 신규 발견 주유소 시민 등록 & 확인 투표 컬렉션
    match /daejeon_gas_candidates/{candidateId} {
      // 모든 사용자가 살펴볼 곳 목록 조회 가능
      allow read: if true;
      
      // 신규 제보 등록 시 필수 필드 및 위경도 유효성 검증
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'addr', 'brand', 'type', 'lat', 'lng', 'phone', 'reason',
        'votesYes', 'votesNo', 'status', 'createdAt', 'updatedAt'
      ]) && request.resource.data.name is string && request.resource.data.name.size() > 0
         && request.resource.data.addr is string && request.resource.data.addr.size() > 0
         && request.resource.data.lat is number && request.resource.data.lng is number;
      
      // 투표 수 변경 및 상태 업데이트 시 지정된 필드만 허용
      allow update: if request.resource.data.keys().hasOnly([
        'name', 'addr', 'brand', 'type', 'lat', 'lng', 'phone', 'reason',
        'votesYes', 'votesNo', 'status', 'createdAt', 'updatedAt'
      ]);
      
      // 시민 등록 후보 데이터 임의 삭제 차단
      allow delete: if false;
    }

    // 4. 위 명시된 컬렉션 외 모든 데이터 접근 전면 차단 (기본 보안 원칙)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
