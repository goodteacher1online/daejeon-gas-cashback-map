rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validInitCounter(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is int
            && request.resource.data[field] >= 0
            && request.resource.data[field] <= 1);
    }

    function validCounterDelta(field) {
      return request.resource.data.get(field, 0) is int
        && request.resource.data.get(field, 0) >= 0
        && (request.resource.data.get(field, 0) - resource.data.get(field, 0)) >= -1
        && (request.resource.data.get(field, 0) - resource.data.get(field, 0)) <= 1;
    }

    function validOptStr(field, maxLen) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= maxLen);
    }

    // 1. 온통대전 주유소 현장 검증 및 위치 검증 통계 컬렉션
    match /daejeon_gas_verifications/{stationId} {
      // 모든 사용자가 실시간 검증 현황 조회 가능
      allow read: if true;

      // 최초 생성 시 숫자 0~1 및 허용 필드/타임스탬프 검증
      allow create: if stationId.matches('^[0-9]{1,3}$')
                    && request.resource.data.keys().hasOnly([
                      'oper', 'inoper', 'lastTime', 'updatedAt',
                      'locOk', 'locWrong', 'lastLocTime'
                    ])
                    && validInitCounter('oper')
                    && validInitCounter('inoper')
                    && validInitCounter('locOk')
                    && validInitCounter('locWrong')
                    && validOptStr('lastTime', 40)
                    && validOptStr('lastLocTime', 40)
                    && request.resource.data.updatedAt == request.time;

      // 업데이트 시 기존 값 대비 ±1 변경 및 음수 방지
      allow update: if stationId.matches('^[0-9]{1,3}$')
                    && request.resource.data.keys().hasOnly([
                      'oper', 'inoper', 'lastTime', 'updatedAt',
                      'locOk', 'locWrong', 'lastLocTime'
                    ])
                    && validCounterDelta('oper')
                    && validCounterDelta('inoper')
                    && validCounterDelta('locOk')
                    && validCounterDelta('locWrong')
                    && validOptStr('lastTime', 40)
                    && validOptStr('lastLocTime', 40)
                    && request.resource.data.updatedAt == request.time;

      // 주유소 통계 데이터 삭제 절대 금지
      allow delete: if false;
    }

    // 2. 시민 위치 오류 수정 제보 내역 컬렉션
    match /daejeon_gas_location_reports/{reportId} {
      // 제보 내역 조회 허용
      allow read: if true;

      // 제보 작성 시 규격 검증 (지정 필드, 타입, 글자수 및 서버 타임스탬프)
      allow create: if request.resource.data.keys().hasOnly(['stationId', 'stationName', 'note', 'createdAt'])
                   && request.resource.data.keys().hasAll(['stationId', 'stationName', 'note', 'createdAt'])
                   && request.resource.data.stationId is int
                   && request.resource.data.stationName is string
                   && request.resource.data.stationName.size() <= 100
                   && request.resource.data.note is string
                   && request.resource.data.note.size() > 0
                   && request.resource.data.note.size() <= 1000
                   && request.resource.data.createdAt == request.time;

      // 이미 등록된 제보의 임의 변조 및 삭제 차단
      allow update, delete: if false;
    }

    // 3. 🔍 신규 발견 주유소 시민 등록 & 확인 투표 컬렉션
    match /daejeon_gas_candidates/{candidateId} {
      // 모든 사용자가 살펴볼 곳 목록 조회 가능
      allow read: if true;

      // 신규 제보 등록 시 필수 필드, 길이, 좌표 범위 및 초기 투표값 검증
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'addr', 'brand', 'type', 'lat', 'lng', 'phone', 'reason',
        'votesYes', 'votesNo', 'status', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'name', 'addr', 'brand', 'type', 'lat', 'lng', 'phone', 'reason',
        'votesYes', 'votesNo', 'status', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 80
      && request.resource.data.addr is string
      && request.resource.data.addr.size() > 0
      && request.resource.data.addr.size() <= 150
      && request.resource.data.brand is string
      && request.resource.data.brand.size() <= 50
      && request.resource.data.type in ['oil', 'lpg']
      && request.resource.data.lat is number
      && request.resource.data.lat >= 33.0 && request.resource.data.lat <= 39.0
      && request.resource.data.lng is number
      && request.resource.data.lng >= 124.0 && request.resource.data.lng <= 132.0
      && request.resource.data.phone is string
      && request.resource.data.phone.size() <= 30
      && request.resource.data.reason is string
      && request.resource.data.reason.size() <= 500
      && request.resource.data.votesYes == 1
      && request.resource.data.votesNo == 0
      && request.resource.data.status == 'candidate'
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;

      // 투표 변경 및 상태 승격 시 투표 수 ±1 및 불변 필드 보호
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'votesYes', 'votesNo', 'status', 'updatedAt'
      ])
      && validCounterDelta('votesYes')
      && validCounterDelta('votesNo')
      && request.resource.data.status in ['candidate', 'approved']
      && (request.resource.data.status == resource.data.status
          || (request.resource.data.status == 'approved' && request.resource.data.votesYes >= 3))
      && request.resource.data.updatedAt == request.time;

      // 시민 등록 후보 데이터 임의 삭제 차단
      allow delete: if false;
    }

    // 4. 위 명시된 컬렉션 외 모든 데이터 접근 전면 차단 (기본 보안 원칙)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
