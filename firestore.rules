rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 온통대전 주유소 현장 검증 및 위치 검증 통계 컬렉션
    match /daejeon_gas_verifications/{stationId} {
      // 모든 접속자 실시간 읽기 허용
      allow read: if true;
      // 투표 및 위치 검증 필드만 엄격하게 쓰기/수정 허용
      allow write: if request.resource.data.keys().hasOnly([
        'oper', 'inoper', 'lastTime', 'updatedAt',
        'locOk', 'locWrong', 'lastLocTime'
      ]);
    }

    // 시민 위치 오류 수정 제보 내역 컬렉션
    match /daejeon_gas_location_reports/{reportId} {
      // 모든 접속자 제보 내역 읽기 허용
      allow read: if true;
      // 정해진 필드와 글자 수(1000자 이내) 검증 후 생성만 허용
      allow create: if request.resource.data.keys().hasOnly(['stationId', 'stationName', 'note', 'createdAt'])
                   && request.resource.data.note is string
                   && request.resource.data.note.size() > 0
                   && request.resource.data.note.size() <= 1000;
      // 제보 임의 변조 및 삭제 원천 차단
      allow update, delete: if false;
    }
  }
}
