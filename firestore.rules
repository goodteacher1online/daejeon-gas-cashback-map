rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 온통대전 주유소 현장 검증 컬렉션
    match /daejeon_gas_verifications/{stationId} {
      // 모든 접속자 읽기 허용 (로그인 없이 누구나 현황 열람)
      allow read: if true;
      // 정해진 투표 필드만 쓰기/수정 허용 (악의적 필드 주입 원천 차단)
      allow write: if request.resource.data.keys().hasOnly(['oper', 'inoper', 'lastTime', 'updatedAt']);
    }
  }
}
